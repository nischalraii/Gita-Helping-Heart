# Build context hygiene: never bake secrets, dev deps or host artifacts.

.git
.github
.gitignore
.idea
.vscode
.agents
.claude
.cursor
.junie
.opencode
graphify-out

node_modules
vendor

# Rebuilt inside the image; a stale local build must not leak in.
public/build
public/hot
public/storage

storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*

tests
phpunit.xml
.phpunit.cache

*.md

# Secrets never enter the image; the host injects env at runtime.
.env
.env.*
